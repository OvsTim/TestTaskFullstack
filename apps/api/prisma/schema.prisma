generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MeasurementUnit {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model WorkType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model WorkEntry {
  id          String   @id @default(cuid())
  completedAt DateTime @db.Date
  workName    String
  volume      Decimal  @db.Decimal(12, 2)
  unit        String
  performer   String
  createdAt   DateTime @default(now())

  @@index([completedAt])
}
