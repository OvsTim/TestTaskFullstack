# PostgreSQL (docker-compose)
POSTGRES_USER=worklog
POSTGRES_PASSWORD=worklog
POSTGRES_DB=worklog
# Host port mapped to container 5432 (change if busy: lsof -i :15432)
POSTGRES_PORT=15432

# API — used by apps/api (port must match POSTGRES_PORT)
DATABASE_URL=postgresql://worklog:worklog@localhost:15432/worklog

# API server
API_PORT=3000

# Web dev server (Vite)
VITE_API_URL=http://localhost:3000
